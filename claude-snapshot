#!/usr/bin/env bash
# claude-snapshot — record the currently-active instances AND ephemeral shells
# (name, directory, kind, parent, transcript, model, effort) to a snapshot file,
# so they can be reopened after a reboot resuming the EXACT conversation with the
# same model/effort. Run by the systemd service's ExecStop AND periodically by
# claude-snapshot.timer (so the snapshot stays fresh even on an ungraceful stop),
# and usable manually at any time.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"

snap="$(cs_state_dir)/last-session.tsv"
mkdir -p "$(cs_state_dir)"
# cs_rows columns: 1 name · 5 cwd · 9 transcript · 10 model · 11 effort ·
# 12 kind (instance|shell) · 13 parent. Snapshot order keeps name,cwd,kind,parent
# first (backward compatible with older 4-/2-column snapshots) + appends the resume
# fields; claude-restore-all reads them and passes them through cs_reopen.
cs_rows | awk -F'\t' -v OFS='\t' \
  '$7=="active"{print $1, $5, ($12==""?"instance":$12), $13, $9, $10, $11}' > "$snap"
echo "snapshot: $(wc -l < "$snap" 2>/dev/null || echo 0) active window(s) -> $snap"
